# ScrappyAi — copy to .env and fill in.
# Simple by default: only the 9router block is required to run a real model.
# Hard limits are ON by default (uncommented) so the agent cannot silently
# burn tokens / loop forever. Raise them as your tasks demand.

# --- LLM (clients/9router.js) ------------------------------------------------
# ASSUMPTION: OpenAI-compatible /chat/completions endpoint. Update
# src/clients/9router.js if the real 9router API differs.
NINEROUTER_BASE_URL=https://your-9router-endpoint/v1
NINEROUTER_API_KEY=sk-xxxxx
NINEROUTER_MODEL=gpt-4o-mini
# Stream final answers token-by-token from the model (SSE). Off by default.
# SCRAPPYAI_STREAM=true
# Optional structured output (only for tool-free turns; see README).
# NINEROUTER_RESPONSE_FORMAT=json_object

# --- Web search (tools/search.js) --------------------------------------------
SEARXNG_BASE_URL=https://searxng-production-a06a.up.railway.app/

# --- Files sandbox (tools/filesystem.js) -------------------------------------
# Directory the read_file/write_file tools are confined to. Defaults to CWD.
SCRAPPYAI_FILES_ROOT=./workspace

# --- Context window (core/context.js) ----------------------------------------
# Token budget before ContextWindow starts compacting.
SCRAPPYAI_MAX_TOKENS=16000

# --- Step budget (core/loop) — RUNTIME GUARD ---------------------------------
# Base step ceiling per run. Adaptive mode (default ON) grows the budget up to
# SCRAPPYAI_MAX_STEPS_MAX while real progress is being made, so big tasks
# are not cut off but infinite loops still hit a hard cap.
SCRAPPYAI_MAX_STEPS=15
SCRAPPYAI_ADAPTIVE_MAX_STEPS=true
SCRAPPYAI_MAX_STEPS_MAX=80
# Hard cap per tool (anti "tool misuse" / flailing).
SCRAPPYAI_MAX_TOOL_CALLS_PER_TOOL=12
# Parallel tool-call concurrency.
SCRAPPYAI_PARALLEL_CONCURRENCY=4

# --- Budget manager (src/budget/budget-manager.js) — HARD DEFAULT LIMITS -----
# Every limit below is ON by default. Set to an empty value to disable. The
# run stops with reason 'budget_exceeded' as soon as any limit is hit.
SCRAPPYAI_MAX_MODEL_CALLS=60       # max LLM roundtrips per run
SCRAPPYAI_MAX_TOOL_CALLS=200       # max total tool executions per run
SCRAPPYAI_MAX_NETWORK_CALLS=30     # max HTTP / web_search requests
SCRAPPYAI_MAX_SUBPROCESSES=30      # max shell / code_run subprocesses
SCRAPPYAI_MAX_RUNTIME_MS=600000    # 10 minutes wall-clock per run (10 * 60 * 1000)
SCRAPPYAI_BUDGET_TOKENS=200000     # total in+out tokens across the run
# Per-call HTTP tool bounds.
SCRAPPYAI_HTTP_TIMEOUT_MS=15000
SCRAPPYAI_HTTP_MAX_RESPONSE_SIZE=200000
# SCRAPPYAI_HTTP_ALLOWED_DOMAINS=api.example.com,trusted.example.org

# --- Anti-laziness gates (core/loop + TODO/Spec managers) --------------------
# When true (default), the loop REJECTS premature final answers until TODO.md
# is fully ticked+verified+tested and (if SPEC.md exists) every file is
# implemented+verified. Set to 'false' only to debug a runaway gate.
SCRAPPYAI_STRICT_FINAL=true

# --- Tool approval gate ------------------------------------------------------
# Extra tools that must wait for human/auto approval before running, on top of
# the built-in gates (delete_file, shell_kill, package_install). Comma list.
# SCRAPPYAI_REQUIRE_APPROVAL=shell,package_install

# --- System prompt (index.js: loadSystemPrompt) ------------------------------
# Priority: SCRAPPYAI_SYSTEM_PROMPT_FILE > SCRAPPYAI_SYSTEM_PROMPT > built-in.
# SCRAPPYAI_SYSTEM_PROMPT="You are ScrappyAi, a terse ops assistant."
# SCRAPPYAI_SYSTEM_PROMPT_FILE=./prompts/system.md

# --- Checkpoints / session logs ----------------------------------------------
# Directory under which per-session checkpoints + event logs are written.
# Defaults to ./.scrappyai/sessions/<sessionId>.
# SCRAPPYAI_CHECKPOINT_DIR=./.scrappyai/sessions
# SCRAPPYAI_SESSION_LOG=true

# --- Memory (src/memory/) ----------------------------------------------------
# On by default, zero-config. With no Redis, every layer runs on an
# in-process store. Set SCRAPPYAI_REDIS_URL to upgrade to durable memory.
# SCRAPPYAI_MEMORY_ENABLED=false
# SCRAPPYAI_REDIS_URL=redis://127.0.0.1:6379
# SCRAPPYAI_REDIS_PASSWORD=
# SCRAPPYAI_MEMORY_LOG=false
# SCRAPPYAI_USER_ID=local
# SCRAPPYAI_SESSION_ID=
# SCRAPPYAI_PROJECT_ID=

# --- Logging (src/core/logger.js) --------------------------------------------
# Secrets are ALWAYS redacted regardless of these settings.
# SCRAPPYAI_LOG=false               # fully silence
# SCRAPPYAI_LOG_LEVEL=info          # debug | info | warn | error
# SCRAPPYAI_LOG_FORMAT=pretty       # json | pretty
