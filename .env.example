# ScrappyAi — copy to .env and fill in.
# Simple by default: only the 9router block is required to run a real model.
# Everything else has a sane default and can be left out.

# --- LLM (clients/9router.js) ---------------------------------------------
# ASSUMPTION: OpenAI-compatible /chat/completions endpoint. Update
# src/clients/9router.js if the real 9router API differs.
NINEROUTER_BASE_URL=https://your-9router-endpoint/v1
NINEROUTER_API_KEY=sk-xxxxx
NINEROUTER_MODEL=gpt-4o-mini
# Stream final answers token-by-token from the model (SSE). Requires the
# gateway to support OpenAI-style streaming with `stream:true`. When on, the
# CLI/REPL prints the answer live as it is generated instead of all at once.
# Off by default — most gateways stream fine, but it changes network behavior.
# SCRAPPYAI_STREAM=true
# Optional: only set this if your gateway supports OpenAI-style structured
# output (response_format) AND you are NOT relying on tool calling in the
# same request (the client silently drops response_format whenever tools
# are attached, since the two features conflict on every gateway we know).
# Leave unset unless you've confirmed 9router supports it.
# NINEROUTER_RESPONSE_FORMAT=json_object

# --- Web search (tools/search.js) ------------------------------------------
# Defaults to the shared instance below if unset.
SEARXNG_BASE_URL=https://searxng-production-a06a.up.railway.app/

# --- Files sandbox (tools/files.js) -----------------------------------------
# Directory the read_file/write_file tools are confined to. Defaults to CWD.
SCRAPPYAI_FILES_ROOT=./workspace

# --- Context window (context.js) --------------------------------------------
# Token budget before ContextWindow starts compacting.
SCRAPPYAI_MAX_TOKENS=8000

# --- System prompt (index.js: loadSystemPrompt) -----------------------------
# One knob, two ways to fill it — pick whichever fits the prompt's length.
# Priority: SCRAPPYAI_SYSTEM_PROMPT_FILE > SCRAPPYAI_SYSTEM_PROMPT > built-in default.
# Short prompt inline:
# SCRAPPYAI_SYSTEM_PROMPT="You are ScrappyAi, a terse ops assistant."
# Long prompt from a file (wins if both are set):
# SCRAPPYAI_SYSTEM_PROMPT_FILE=./prompts/system.md

# --- Memory (src/memory/, wired in via memory-integration.js) ---------------
# On by default, zero-config: with no Redis configured, every memory layer
# (session/workspace/episodic/semantic/long-term/tool/project — see
# src/memory/memory-manager.js) transparently runs on an in-process store.
# Non-durable across restarts, but fully functional — session recall, "my
# name is X"-style fact extraction, and semantic recall (via a deterministic
# offline embedding, no API key needed) all just work.
# Set SCRAPPYAI_REDIS_URL to upgrade to durable, cross-restart memory with
# the exact same code path — no flag to flip.
# SCRAPPYAI_MEMORY_ENABLED=false     # uncomment to fully disable memory
# SCRAPPYAI_REDIS_URL=redis://127.0.0.1:6379
# SCRAPPYAI_REDIS_PASSWORD=
# Silence the memory layer's own log lines (kept on by default so a Redis
# fallback is visible instead of silent):
# SCRAPPYAI_MEMORY_LOG=false

# Identity/scoping for memory (all optional, sane defaults below):
# SCRAPPYAI_USER_ID=local            # whose long-term/semantic facts these are
# SCRAPPYAI_SESSION_ID=              # unset = a fresh session id per process start
# SCRAPPYAI_PROJECT_ID=              # unset = no project-scoped memory

# --- Logging (src/logger.js) ------------------------------------------------
# One logger used everywhere: loop, tools, context, reasoner, the 9router
# client, index/repl, and the memory layers. Every line states what state
# the component was in, what parameters drove the call, and what came out
# (plus timing) — see README "Logging" section for the exact event names.
# On by default at "info". Secrets (api keys, tokens, passwords,
# authorization headers) are always redacted before a line is emitted,
# regardless of these settings.
# SCRAPPYAI_LOG=false               # uncomment to fully silence all logging
# SCRAPPYAI_LOG_LEVEL=debug         # debug | info | warn | error (default: info)
# SCRAPPYAI_LOG_FORMAT=json         # json | pretty (default: pretty, human-readable)
